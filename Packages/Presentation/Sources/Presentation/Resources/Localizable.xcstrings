    "learn.arrowArithmetic.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On an arrow, the digits along the shaft add up to the digit in the circle. Arrow arithmetic bounds the circle by the smallest and largest sums the shaft can still make, and bounds each shaft cell by what the circle leaves after the other cells. Little Killer diagonals work the same way with a fixed total."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur une flèche, les chiffres le long du fût s'additionnent pour donner le chiffre du cercle. L'arithmétique de flèche encadre le cercle entre la plus petite et la plus grande somme que le fût peut encore faire, et encadre chaque case du fût par ce que le cercle laisse après les autres cases. Les diagonales du Little Killer fonctionnent de même avec un total fixe."
          }
        }
      }
    },
    "learn.arrowArithmetic.figure" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A 9×9 Arrow board with a circled cell in the centre and a two-cell shaft to its right. The first shaft cell holds a 4. The circle shows 2, 3, 5, 6, 7 and 8 with 2 and 3 struck through, because the shaft sums to at least 5."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une grille Flèche 9×9 avec une case cerclée au centre et un fût de deux cases à sa droite. La première case du fût contient un 4. Le cercle affiche 2, 3, 5, 6, 7 et 8 avec 2 et 3 barrés, car le fût totalise au moins 5."
          }
        }
      }
    },
    "learn.arrowArithmetic.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every shaft cell is at least 1, so the circle is always at least the shaft's length; and no shaft cell can exceed the circle minus the other cells."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque case du fût vaut au moins 1, donc le cercle vaut toujours au moins la longueur du fût ; et aucune case du fût ne peut dépasser le cercle moins les autres cases."
          }
        }
      }
    },
    "learn.arrowArithmetic.where" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look at arrows with a placed digit on the shaft or in the circle, and at long shafts: a three-cell shaft inside one line already needs a circle of 6 or more."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regardez les flèches avec un chiffre placé sur le fût ou dans le cercle, et les longs fûts : un fût de trois cases dans une même ligne exige déjà un cercle de 6 ou plus."
          }
        }
      }
    },
    "learn.boxLineReduction.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Box-line reduction is the mirror of the pointing pair. When a digit's only candidates in a row or column all fall inside one box, the line must take the digit there, so the digit can be removed from the other cells of that box."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La réduction région-ligne est le miroir de la paire pointante. Quand les seuls candidats d'un chiffre dans une ligne ou une colonne tombent tous dans une même région, la ligne doit y placer ce chiffre ; on peut donc le retirer des autres cases de cette région."
          }
        }
      }
    },
    "learn.boxLineReduction.figure" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A 9×9 board. In row 4, the digit 6 fits only in the first two cells, which are highlighted and lie in the middle-left box. Two other cells of that box show a struck-through 6."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une grille 9×9. Dans la ligne 4, le chiffre 6 ne tient que dans les deux premières cases, surlignées, situées dans la région du milieu à gauche. Deux autres cases de cette région affichent un 6 barré."
          }
        }
      }
    },
    "learn.boxLineReduction.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A line with several givens and a digit squeezed into one box segment is the classic trigger."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une ligne avec plusieurs indices et un chiffre coincé dans un seul segment de région est le déclencheur classique."
          }
        }
      }
    },
    "learn.boxLineReduction.where" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For each row or column and each missing digit, note which boxes its candidates touch. If they touch only one, clean that box."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour chaque ligne ou colonne et chaque chiffre manquant, notez quelles régions ses candidats touchent. S'ils n'en touchent qu'une, nettoyez cette région."
          }
        }
      }
    },
    "learn.cageArithmetic.definition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Killer sudoku, the digits inside a cage are distinct and add up to the cage's sum. Cage arithmetic lists the combinations that fit the sum and the number of cells, and removes every digit that appears in none of them. When one cell of a cage is left, it takes whatever completes the sum."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au Killer, les chiffres d'une cage sont distincts et leur somme vaut le total de la cage. L'arithmétique de cage liste les combinaisons compatibles avec la somme et le nombre de cases, puis retire tout chiffre absent de chacune d'elles. Quand il ne reste qu'une case dans la cage, elle prend ce qui complète la somme."
          }
        }
      }
    },
    "learn.cageArithmetic.figure" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A 9×9 Killer board with one three-cell cage in the centre box, marked with the sum 7. The top-left cage cell holds a 1; the other two show 2, 3 and 4 with 3 struck through, since 1, 2 and 4 is the only combination."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une grille Killer 9×9 avec une cage de trois cases dans la région centrale, marquée de la somme 7. La case en haut à gauche de la cage contient un 1 ; les deux autres affichent 2, 3 et 4 avec le 3 barré, puisque 1, 2 et 4 est la seule combinaison."
          }
        }
      }
    },
    "learn.cageArithmetic.tip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Learn the unique combinations by heart; they solve the first moves of most Killer puzzles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apprenez par cœur les combinaisons uniques ; elles résolvent les premiers coups de la plupart des Killer."
          }
        }
      }
    },
    "learn.cageArithmetic.where" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start with small cages and extreme sums: two cells adding to 3, 4, 16 or 17 and three cells adding to 6, 7, 23 or 24 have a single combination. Placed digits shrink the remaining sum and narrow later cages."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez par les petites cages et les sommes extrêmes : deux cases totalisant 3, 4, 16 ou 17 et trois cases totalisant 6, 7, 23 ou 24 n'ont qu'une seule combinaison. Les chiffres placés réduisent la somme restante et resserrent les cages suivantes."
          }
        }
      }
    },
    "learn.figure.legend.eliminations" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Highlighted cells form the pattern; struck-through pencil marks are the candidates it eliminates."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cases surlignées forment le motif ; les notes barrées sont les candidats qu'il élimine."
          }
        }
      }
    },
    "learn.figure.legend.placement" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Highlighted cells form the pattern; the coloured digit is the placement it proves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cases surlignées forment le motif ; le chiffre en couleur est le placement qu'il prouve."
          }
        }
      }
    },
