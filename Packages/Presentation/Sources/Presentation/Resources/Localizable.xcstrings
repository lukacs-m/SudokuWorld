          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Révélation"
          }
        }
      }
    },
    "hint.revealInstead" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reveal a cell instead"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Révéler une case à la place"
          }
        }
      }
    },
    "hint.technique.arrowArithmetic" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sum along the highlighted line rules out %1$@ here."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La somme le long de la ligne en évidence exclut %1$@ ici."
          }
        }
      }
    },
    "hint.technique.boxLineReduction" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the highlighted line, %@ only fits inside one region — it can be removed from the rest of that region."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur la ligne surlignée, %@ ne peut se placer que dans une seule région — il peut être retiré du reste de cette région."
          }
        }
      }
    },
    "hint.technique.cageArithmetic" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The cage's sum only allows digits %@ in its remaining cells."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La somme de la cage n'autorise que les chiffres %@ dans ses cases restantes."
          }
        }
      }
    },
    "hint.technique.hiddenPair" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digits %@ only fit in the two highlighted cells of this region, so those cells can hold nothing else."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les chiffres %@ ne peuvent aller que dans les deux cases surlignées de cette région : elles ne peuvent rien contenir d'autre."
          }
        }
      }
    },
    "hint.technique.hiddenSingle" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digit %1$@ has only one possible home in one of its regions: row %2$@, column %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chiffre %1$@ n'a qu'un seul emplacement possible dans l'une de ses régions : ligne %2$@, colonne %3$@."
          }
        }
      }
    },
    "hint.technique.hiddenTriple" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digits %@ only fit in the three highlighted cells of this region, so those cells can hold nothing else."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les chiffres %@ ne peuvent aller que dans les trois cases surlignées de cette région : elles ne peuvent rien contenir d'autre."
          }
        }
      }
    },
    "hint.technique.nakedPair" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digits %@ are locked into the two highlighted cells, so they can be removed as candidates from the rest of the region."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les chiffres %@ sont confinés aux deux cases surlignées : ils peuvent être retirés des candidats du reste de la région."
          }
        }
      }
    },
    "hint.technique.nakedSingle" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This cell can only be %1$@ — every other digit is blocked by its row, column, or box (row %2$@, column %3$@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette case ne peut contenir que %1$@ — tous les autres chiffres sont exclus par sa ligne, sa colonne ou sa région (ligne %2$@, colonne %3$@)."
          }
        }
      }
    },
    "hint.technique.nakedTriple" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digits %@ are locked into the three highlighted cells, so they can be removed from the rest of the region."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les chiffres %@ sont confinés aux trois cases surlignées : ils peuvent être retirés du reste de la région."
          }
        }
      }
    },
    "hint.technique.outsideClueAnalysis" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The clue at the edge of the highlighted line rules out %1$@ here."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'indice au bord de la ligne en évidence exclut %1$@ ici."
          }
        }
      }
    },
    "hint.technique.pointingPair" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the highlighted region, %@ only fits along a single line — it can be removed from that line outside the region."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans la région surlignée, %@ ne peut se placer que sur une seule ligne — il peut être retiré de cette ligne hors de la région."
          }
        }
      }
    },
    "hint.technique.relationAnalysis" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The mark between the highlighted cells rules out %1$@ here."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La marque entre les cases en évidence exclut %1$@ ici."
          }
        }
      }
    },
    "hint.technique.swordfish" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digit %@ forms a swordfish across the highlighted lines — it can be removed from the other cells of the covering lines."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chiffre %@ forme un espadon sur les lignes surlignées — il peut être retiré des autres cases des lignes couvrantes."
          }
        }
      }
    },
    "hint.technique.xWing" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digit %@ forms an X-wing on the highlighted corners — it can be removed from the other cells of the covering lines."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chiffre %@ forme un X-wing sur les coins surlignés — il peut être retiré des autres cases des lignes couvrantes."
          }
        }
      }
    },
    "hint.technique.xyChain" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chain of paired cells proves one of its two ends must be %1$@ — cells seeing both ends can't be %1$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une chaîne de cases appariées prouve qu'une de ses extrémités vaut %1$@ — les cases voyant les deux extrémités ne peuvent pas valoir %1$@."
          }
        }
      }
    },
    "hint.technique.xyWing" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The highlighted pivot and its two pincers force %@ out of every cell that sees both pincers."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pivot surligné et ses deux pinces excluent %@ de toute case voyant les deux pinces."
          }
        }
      }
    },
