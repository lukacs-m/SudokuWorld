    "hint.apply" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Apply" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Appliquer" } } } },
    "hint.revealInstead" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reveal a cell instead" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Révéler une case à la place" } } } },
    "hint.reveal.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reveal" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Révélation" } } } },
    "hint.mistake" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The digit at row %1$@, column %2$@ doesn't match the solution. Apply to fix it." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le chiffre en ligne %1$@, colonne %2$@ ne correspond pas à la solution. Appliquez pour corriger." } } } },
    "hint.reveal" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The cell at row %2$@, column %3$@ is %1$@." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "La case en ligne %2$@, colonne %3$@ vaut %1$@." } } } },

    "hint.technique.nakedSingle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This cell can only be %1$@ — every other digit is blocked by its row, column, or box (row %2$@, column %3$@)." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Cette case ne peut contenir que %1$@ — tous les autres chiffres sont exclus par sa ligne, sa colonne ou sa région (ligne %2$@, colonne %3$@)." } } } },
    "hint.technique.hiddenSingle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Digit %1$@ has only one possible home in one of its regions: row %2$@, column %3$@." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le chiffre %1$@ n'a qu'un seul emplacement possible dans l'une de ses régions : ligne %2$@, colonne %3$@." } } } },
    "hint.technique.nakedPair" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Digits %@ are locked into the two highlighted cells, so they can be removed as candidates from the rest of the region." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les chiffres %@ sont confinés aux deux cases surlignées : ils peuvent être retirés des candidats du reste de la région." } } } },
    "hint.technique.hiddenPair" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Digits %@ only fit in the two highlighted cells of this region, so those cells can hold nothing else." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les chiffres %@ ne peuvent aller que dans les deux cases surlignées de cette région : elles ne peuvent rien contenir d'autre." } } } },
    "hint.technique.nakedTriple" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Digits %@ are locked into the three highlighted cells, so they can be removed from the rest of the region." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les chiffres %@ sont confinés aux trois cases surlignées : ils peuvent être retirés du reste de la région." } } } },
    "hint.technique.hiddenTriple" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Digits %@ only fit in the three highlighted cells of this region, so those cells can hold nothing else." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les chiffres %@ ne peuvent aller que dans les trois cases surlignées de cette région : elles ne peuvent rien contenir d'autre." } } } },
    "hint.technique.pointingPair" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "In the highlighted region, %@ only fits along a single line — it can be removed from that line outside the region." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Dans la région surlignée, %@ ne peut se placer que sur une seule ligne — il peut être retiré de cette ligne hors de la région." } } } },
    "hint.technique.boxLineReduction" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On the highlighted line, %@ only fits inside one region — it can be removed from the rest of that region." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Sur la ligne surlignée, %@ ne peut se placer que dans une seule région — il peut être retiré du reste de cette région." } } } },
    "hint.technique.xWing" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Digit %@ forms an X-wing on the highlighted corners — it can be removed from the other cells of the covering lines." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le chiffre %@ forme un X-wing sur les coins surlignés — il peut être retiré des autres cases des lignes couvrantes." } } } },
    "hint.technique.cageArithmetic" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The cage's sum only allows digits %@ in its remaining cells." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "La somme de la cage n'autorise que les chiffres %@ dans ses cases restantes." } } } },

    "technique.nakedSingle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Naked Single" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Single nu" } } } },
    "technique.hiddenSingle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hidden Single" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Single caché" } } } },
    "technique.nakedPair" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Naked Pair" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Paire nue" } } } },
