    "hint.reveal" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The cell at row %2$@, column %3$@ is %1$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La case en ligne %2$@, colonne %3$@ vaut %1$@."
          }
        }
      }
    },
    "hint.reveal.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
